#!/usr/bin/env sh
# Pre-commit hook: run the fast lint + secrets gates — delegate to
# `make lint-check`, then run gitleaks over the staged diff.
#
# Install: `make install-hooks` (copies this file to .git/hooks/pre-commit).
# Re-run `make install-hooks` after pulling updates — this file is the
# single source of truth; the copy in .git/hooks is not versioned.
#
# Why `make lint-check` and not ruff directly: CI runs the same target
# (via `make test`), so the hook and CI can never drift apart. lint-check
# depends on `deps` (uv sync), never on install-hooks — a hook calling
# `make check` would re-copy/refuse the very hook file (the deadlock).
#
# Skips on: nothing staged (nothing to lint) or when the venv isn't set up.

set -e

if [ -z "$(git diff --cached --name-only)" ]; then
    exit 0  # nothing staged — nothing to check
fi

# Secrets scan — runs on ANY staged change (configs, shell scripts,
# .env.example included), never only Python. One-time install:
# `go install github.com/gitleaks/gitleaks/v8@latest` or brew. Fail loudly
# when missing: a scan that silently disappears is a scan that never runs.
if command -v gitleaks >/dev/null 2>&1; then
    gitleaks git --pre-commit --redact --staged
else
    echo "pre-commit: gitleaks not on PATH — install it (go install github.com/gitleaks/gitleaks/v8@latest or brew), or drop this block from the hook" >&2
    exit 1
fi

# Lint gate — only when the commit touches Python.
if [ -z "$(git diff --cached --name-only -- '*.py')" ]; then
    exit 0
fi

if [ ! -x .venv/bin/ruff ]; then
    echo "pre-commit: .venv missing — run 'make setup' first"
    exit 1
fi

make lint-check
